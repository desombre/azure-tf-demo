# Dev environment inputs.
# Copy to env/dev/terraform.tfvars (gitignored) and replace the placeholders.
# Never put secrets here — sensitive values belong in Key Vault (issue #5).

subscription_id     = "00000000-0000-0000-0000-000000000000" # Dev subscription
environment         = "dev"
location            = "westeurope"
resource_group_name = "rg-dev-network"
vnet_name           = "vnet-dev"

# Single /16 holds both subnets below with room for a third if the design grows.
address_space = ["10.0.0.0/16"]

# Subnets must sit inside address_space and never overlap each other.
# The AKS subnet needs at least a /23 for Azure CNI per node pool.
aks_subnet_address_prefixes             = ["10.0.1.0/24"]
private_endpoints_subnet_address_prefixes = ["10.0.2.0/24"]

# The Private Link baseline rules (443 from the VNet, 443 for load balancer probes) are
# built into the stack. Add environment-specific rules here, priority 200 and above:
# pe_nsg_extra_rules = [{
#   name                    = "Allow-Storage-Replication-Inbound"
#   priority                = 200
#   direction               = "Inbound"
#   access                  = "Allow"
#   protocol                = "Tcp"
#   source_address_prefixes = ["10.0.3.0/24"]
#   destination_port_range  = "443"
# }]

owner = "your-name"

tags = {
  Repository = "https://github.com/desombre/azure-tf-demo"
}
