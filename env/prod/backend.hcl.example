# Prod backend — copy to env/prod/backend.hcl (gitignored) and fill in from the bootstrap
# stack run with environment = "prod".
#
# No secrets belong in this file. The backend authenticates with Entra ID from your
# environment (az login, ARM_CLIENT_ID/SECRET, or CI OIDC), so there is no access key.

resource_group_name  = "rg-prod-tfstate"
storage_account_name = "aztfstateexampleprod"
container_name       = "tfstate"

# Names the blob after the environment so a misplaced backend.hcl cannot aim Prod at Dev state.
key = "prod/terraform.tfstate"

# The state account lives in this subscription. `az login` can infer the current one, but
# service-principal and OIDC auth cannot: init fails with "A Subscription ID must be
# configured" unless it is set here or exported as ARM_SUBSCRIPTION_ID. Setting it here keeps
# init identical locally and in CI and pins Prod state to the Prod subscription.
subscription_id = "00000000-0000-0000-0000-000000000000" # Prod subscription

use_azuread_auth = true
